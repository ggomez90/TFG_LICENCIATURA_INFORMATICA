// datasource + generador
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tablas catalogo (enum en diagrama de clases), los id son predefinidiso en archivos semillas

model EstadoDesafio {
  idEstadoDesafio Int       @id
  descripcion     String    @db.VarChar(50)

  // Usos
  Desafios        Desafio[]
  Inscripciones   InscripcionDesafio[]
}

model EstadoEntrega {
  idEstadoEntrega Int      @id
  descripcion     String   @db.VarChar(50)

  // Usos
  Entregas        Entrega[]
}

model EstadoVoucher {
  idEstadoVoucher Int      @id
  descripcion     String   @db.VarChar(50)

  // Usos
  Vouchers        Voucher[]
}

model EstadoUsuario {
  idEstadoUsuario Int      @id
  descripcion     String   @db.VarChar(50)

  // Usos
  Usuarios        Usuario[]
}

model TipoMovimiento {
  idTipoMovimiento Int             @id
  descripcion      String          @db.VarChar(50)

  // Usos
  Movimientos      MovimientoPuntos[]
}

model RolUsuario {
  idRolUsuario Int       @id
  descripcion  String    @db.VarChar(50)

  // Usos
  Usuarios     Usuario[]
  Notificaciones Notificacion[]
}

model OrigenMovimiento {
  idOrigenMovimiento Int             @id
  descripcion        String          @db.VarChar(50)

  Movimientos        MovimientoPuntos[]
}

model TipoCliente {
  idTipoCliente Int      @id
  descripcion   String   @db.VarChar(50)

  // Usos
  Clientes      Cliente[]
}

model Provincia {
  idProvincia Int       @id
  nombre      String    @db.VarChar(50)

  Localidades Localidad[]
  Clientes    Cliente[]
}

model Localidad {
  idLocalidad  Int        @id
  nombre       String     @db.VarChar(50)
  idProvincia  Int
  provincia    Provincia  @relation(fields: [idProvincia], references: [idProvincia], onDelete: Restrict, onUpdate: Cascade)

  Clientes     Cliente[]
}

// Tablas

model Usuario {
  idUsuario        Int              @id @default(autoincrement())
  nombres          String?          @db.VarChar(100)
  apellidos        String?          @db.VarChar(100)
  dniCuitCuil      String?          @unique(map: "uq_doc")     @db.VarChar(20)
  usuario          String           @unique(map: "uq_usuario") @db.VarChar(80)
  email            String           @unique(map: "uq_email")   @db.VarChar(120)
  motivoBan        String?          @db.VarChar(300)

  // Estados/Roles
  idRolUsuario     Int
  rol              RolUsuario       @relation(fields: [idRolUsuario], references: [idRolUsuario], onDelete: Restrict, onUpdate: Cascade)

  idEstadoUsuario  Int
  estadoUsuario    EstadoUsuario    @relation(fields: [idEstadoUsuario], references: [idEstadoUsuario], onDelete: Restrict, onUpdate: Cascade)

  // One-to-one con Cliente (opcional si es CLIENTE)
  cliente          Cliente?

  // Rel. como Operario validador de Entregas
  EntregasValidadas Entrega[]       @relation("Entrega_Operario")

  // Creados por admin:
  Contenidos       ContenidoEducativo[] @relation("Contenido_Admin")
  VoucherTipos     VoucherTipo[]        @relation("VoucherTipo_Admin")
  Encuestas        Encuesta[]           @relation("Encuesta_Admin")
  Notificaciones   Notificacion[]       @relation("Notificacion_Admin")
  Desafios         Desafio[]            @relation("Desafio_Admin")

  // Movimientos asignados por admin
  MovsComoAdmin    MovimientoPuntos[]   @relation("Movimiento_Admin")

  // Respuestas de encuestas como usuario autenticado
  Respuestas       RespuestaEncuesta[]

  @@index([idRolUsuario])
  @@index([idEstadoUsuario])
}

model Cliente {
  // PK = FK a Usuario
  idCliente      Int      @id
  usuario        Usuario  @relation(fields: [idCliente], references: [idUsuario], onDelete: Cascade, onUpdate: Cascade)

  razonSocial    String?  @db.VarChar(100)
  direccion      String   @db.VarChar(100)

  idProvincia    Int
  provincia      Provincia @relation(fields: [idProvincia], references: [idProvincia], onDelete: Restrict, onUpdate: Cascade)

  idLocalidad    Int
  localidad      Localidad @relation(fields: [idLocalidad], references: [idLocalidad], onDelete: Restrict, onUpdate: Cascade)

  idTipoCliente  Int?
  tipoCliente    TipoCliente? @relation(fields: [idTipoCliente], references: [idTipoCliente], onDelete: SetNull, onUpdate: Cascade)

  puntos         Int      @default(0)

  // Relaciones derivadas
  Vouchers       Voucher[]
  Inscripciones  InscripcionDesafio[]
  Entregas       Entrega[]
  Movimientos    MovimientoPuntos[]

  @@index([idProvincia])
  @@index([idLocalidad])
  @@index([idTipoCliente])
}

model Voucher {
  idVoucher        Int           @id @default(autoincrement())
  idCliente        Int
  cliente          Cliente       @relation(fields: [idCliente], references: [idCliente], onDelete: Cascade, onUpdate: Cascade)

  idVoucherTipo    Int
  voucherTipo      VoucherTipo   @relation(fields: [idVoucherTipo], references: [idVoucherTipo], onDelete: Restrict, onUpdate: Cascade)

  estadoVoucher    Int
  estado           EstadoVoucher @relation(fields: [estadoVoucher], references: [idEstadoVoucher], onDelete: Restrict, onUpdate: Cascade)

  fechaAdquisicion DateTime      @default(now())
  fechaUso         DateTime?

  Movimientos      MovimientoPuntos[]

  @@index([idCliente])
  @@index([idVoucherTipo])
  @@index([estadoVoucher])
}

model RespuestaEncuesta {
  idRespuesta      Int       @id @default(autoincrement())
  idEncuesta       Int
  encuesta         Encuesta  @relation(fields: [idEncuesta], references: [idEncuesta], onDelete: Cascade, onUpdate: Cascade)

  idUsuario        Int?
  usuario          Usuario?  @relation(fields: [idUsuario], references: [idUsuario], onDelete: SetNull, onUpdate: Cascade)

  datosInvitado        String?  @db.VarChar(100)
  dniCuilCuitInvitado  String?  @db.VarChar(20)
  fechaRespuesta       DateTime @default(now())
  contenido            String   @db.VarChar(300)

  @@index([idEncuesta])
  @@index([idUsuario])
}

model InscripcionDesafio {
  idInscripcionDesafio Int        @id @default(autoincrement())
  idCliente            Int
  cliente              Cliente    @relation(fields: [idCliente], references: [idCliente], onDelete: Cascade, onUpdate: Cascade)

  idDesafio            Int
  desafio              Desafio    @relation(fields: [idDesafio], references: [idDesafio], onDelete: Cascade, onUpdate: Cascade)

  fechaAdhesion        DateTime   @default(now())
  fechaBaja            DateTime?
  progreso             Decimal    @default(0) @db.Decimal(10,2)
  puntosAcumulados     Int        @default(0)

  estado               Int
  estadoDesafio        EstadoDesafio @relation(fields: [estado], references: [idEstadoDesafio], onDelete: Restrict, onUpdate: Cascade)

  Entregas             Entrega[]

  @@index([idCliente])
  @@index([idDesafio])
  @@index([estado])
}

model Entrega {
  idEntrega            Int         @id @default(autoincrement())
  idCliente            Int
  cliente              Cliente     @relation(fields: [idCliente], references: [idCliente], onDelete: Cascade, onUpdate: Cascade)

  idDesafio            Int
  desafio              Desafio     @relation(fields: [idDesafio], references: [idDesafio], onDelete: Cascade, onUpdate: Cascade)

  idInscripcionDesafio Int
  inscripcion          InscripcionDesafio @relation(fields: [idInscripcionDesafio], references: [idInscripcionDesafio], onDelete: Cascade, onUpdate: Cascade)

  fechaCreacion        DateTime    @default(now())
  fechaVencimiento     DateTime
  fechaValidacion      DateTime?

  cantidadDeclarada    Decimal     @db.Decimal(12,3)
  cantidadVerificada   Decimal?    @db.Decimal(12,3)

  estado               Int
  estadoEntrega        EstadoEntrega @relation(fields: [estado], references: [idEstadoEntrega], onDelete: Restrict, onUpdate: Cascade)

  observaciones        String?     @db.VarChar(300)

  idOperarioValidador  Int?
  OperarioValidador    Usuario?    @relation("Entrega_Operario", fields: [idOperarioValidador], references: [idUsuario], onDelete: SetNull, onUpdate: Cascade)

  motivoRechazo        String?     @db.VarChar(300)
  ubicacion            String?     @db.VarChar(100)

  Movimientos          MovimientoPuntos[]

  @@index([idCliente])
  @@index([idDesafio])
  @@index([idInscripcionDesafio])
  @@index([estado])
  @@index([idOperarioValidador])
}

model MovimientoPuntos {
  idMovimiento  Int       @id @default(autoincrement())
  idCliente     Int
  fecha         DateTime
  tipo          Int
  origen        Int
  puntos        Int
  descripcion   String?    @db.VarChar(100)
  idEntrega     Int?
  idVoucher     Int?
  idAdmin       Int?

  // Relaciones
  cliente       Cliente    @relation(fields: [idCliente], references: [idCliente], onDelete: Cascade, onUpdate: Cascade)
  entrega       Entrega?   @relation(fields: [idEntrega], references: [idEntrega], onDelete: SetNull, onUpdate: Cascade)
  voucher       Voucher?   @relation(fields: [idVoucher], references: [idVoucher], onDelete: SetNull, onUpdate: Cascade)
  admin         Usuario?   @relation("Movimiento_Admin", fields: [idAdmin], references: [idUsuario], onDelete: SetNull, onUpdate: Cascade)

  tipoMovimiento    TipoMovimiento    @relation(fields: [tipo],   references: [idTipoMovimiento],   onDelete: Restrict, onUpdate: Cascade)
  origenMovimiento  OrigenMovimiento  @relation(fields: [origen], references: [idOrigenMovimiento], onDelete: Restrict, onUpdate: Cascade)

  @@index([idCliente])
  @@index([tipo])
  @@index([origen])
  @@index([idEntrega])
  @@index([idVoucher])
  @@index([idAdmin])
}


model ContenidoEducativo {
  idContenidoEducativo Int      @id @default(autoincrement())
  idAdmin              Int
  admin                Usuario  @relation("Contenido_Admin", fields: [idAdmin], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade)

  titulo               String?  @db.VarChar(300)
  descripcion          String?  @db.VarChar(2000)
  urlRecurso           String?  @db.VarChar(300)
  fechaPublicacion     DateTime @default(now())
  fechaBaja            DateTime?
  visible              Boolean  @default(false)

  Desafios             Desafio[]
}

model VoucherTipo {
  idVoucherTipo     Int      @id @default(autoincrement())
  idAdmin           Int
  admin             Usuario  @relation("VoucherTipo_Admin", fields: [idAdmin], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade)

  titulo            String   @db.VarChar(200)
  descripcion       String   @db.VarChar(500)
  puntosRequeridos  Int
  montoBeneficio    Int
  fechaInicioVigencia DateTime
  fechaFinVigencia    DateTime
  activa            Boolean  @default(false)

  Vouchers          Voucher[]
}

model Encuesta {
  idEncuesta       Int       @id @default(autoincrement())
  idAdmin          Int
  admin            Usuario   @relation("Encuesta_Admin", fields: [idAdmin], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade)

  titulo           String    @db.VarChar(300)
  descripcion      String    @db.VarChar(5000)
  fechaPublicacion DateTime
  fechaCierre      DateTime
  activa           Boolean   @default(false)

  Respuestas       RespuestaEncuesta[]
}

model Notificacion {
  idNotificacion  Int       @id @default(autoincrement())
  idAdmin         Int
  admin           Usuario   @relation("Notificacion_Admin", fields: [idAdmin], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade)

  idRolUsuario    Int
  rolDestino      RolUsuario @relation(fields: [idRolUsuario], references: [idRolUsuario], onDelete: Restrict, onUpdate: Cascade)

  titulo          String    @db.VarChar(100)
  mensaje         String    @db.VarChar(300)
  fechaCreacion   DateTime  @default(now())
  visible         Boolean   @default(true)

  @@index([idRolUsuario])
  @@index([idAdmin])
}

model Desafio {
  idDesafio                 Int       @id @default(autoincrement())
  idAdmin                   Int
  admin                     Usuario   @relation("Desafio_Admin", fields: [idAdmin], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade)

  titulo                    String    @db.VarChar(500)
  descripcion               String    @db.VarChar(5000)
  tipoResiduo               String    @db.VarChar(200)
  requiereInscripcion       Boolean   @default(false)
  unidadMedida              String    @db.VarChar(200)
  meta                      Decimal   @db.Decimal(12,3)
  puntosTotales             Int
  puntosPorUnidad           Decimal?  @db.Decimal(12,3)
  bonificacionDesafioCompleto Int? 
  otorgaPuntosParcial       Boolean   @default(false)
  fechaInicio               DateTime
  fechaFin                  DateTime?

  estado                    Int
  estadoObj                 EstadoDesafio @relation(fields: [estado], references: [idEstadoDesafio], onDelete: Restrict, onUpdate: Cascade)

  idRecursoEducativo        Int?
  recursoEducativo          ContenidoEducativo? @relation(fields: [idRecursoEducativo], references: [idContenidoEducativo], onDelete: SetNull, onUpdate: Cascade)

  Inscripciones             InscripcionDesafio[]
  Entregas                  Entrega[]

  @@index([idAdmin])
  @@index([estado])
  @@index([idRecursoEducativo])
}
